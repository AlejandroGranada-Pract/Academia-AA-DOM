// Academia AA | DOM — Esquema de base de datos
// Stack: Prisma 7 (generador prisma-client) + PostgreSQL + driver adapter (@prisma/adapter-pg)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión vive en prisma.config.ts (Prisma 7 ya no la acepta aquí).
}

// ===================== ENUMS =====================

enum Role {
  SUPER_ADMIN // Isa / TI: gestión total
  AREA_LEADER // Líderes: ve métricas de su equipo, asigna cursos
  EMPLOYEE    // Empleados: ve cursos asignados, avanza
  EXTERNAL    // Técnicos externos: acceso limitado
}

enum Company {
  AMBIENTE_AZUL
  DOM_DESIGN
  AMBAS
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseCategory {
  INDUCCION          // Inducción general (todos)
  CAPACITACION_AREA  // Capacitación inicial por área
  FORMACION_CONTINUA // Formación continua / actualizaciones
  TECNICO            // Capacitaciones técnicas especializadas
  PRODUCTO           // Conocimiento de producto
  PROCESO            // Procesos internos
}

enum LessonType {
  TEXT  // Texto con formato (Markdown o HTML)
  VIDEO // Video embebido (YouTube/Drive)
  IMAGE // Imagen con descripción
  PDF   // PDF embebido o descargable
  MIXED // Combinación de contenido
}

enum QuestionType {
  MULTIPLE_CHOICE // Una respuesta correcta
  MULTI_SELECT    // Varias respuestas correctas
  TRUE_FALSE      // Verdadero/Falso
  FILL_BLANK      // Completar espacio
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AttemptStatus {
  IN_PROGRESS // examen abierto, aún sin enviar
  COMPLETED   // enviado y calificado
  ABANDONED   // se salió sin enviar (consume intento)
}

// ===================== MODELOS =====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  company      Company
  area         String? // Comercial, Técnico, Administrativo, Bodega, etc.
  avatar       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments     CourseAssignment[]
  progress        UserProgress[]
  examAttempts    ExamAttempt[]
  certificates    Certificate[]
  badges          UserBadge[]
  lessonComments  LessonComment[]
  grupos          Grupo[]            @relation("UserGrupos") // grupos a los que pertenece
  gruposLiderados Grupo[]            @relation("GrupoLideres") // grupos que lidera (AREA_LEADER)
}

// Insignias/logros de gamificación ganados por el usuario. El catálogo (qué
// insignias existen y sus criterios) vive en código (src/lib/badges.ts); aquí
// solo se registra cuál ganó cada quien y cuándo.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String // identificador del logro en el catálogo
  earnedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

// Grupo / rol funcional (Técnico, Compras, Comercial...) que decide qué cursos
// ve cada usuario. El admin crea grupos y les asocia cursos y usuarios.
model Grupo {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users   User[]   @relation("UserGrupos")
  lideres User[]   @relation("GrupoLideres")
  courses Course[] @relation("CourseGrupos")
}

model Course {
  id             String         @id @default(cuid())
  title          String
  description    String
  thumbnail      String? // URL de imagen
  category       CourseCategory
  company        Company // Para cuál empresa aplica
  status         CourseStatus   @default(DRAFT)
  requiredAreas  String[] // Áreas que deben completarlo (vacío = opcional)
  dueDate        DateTime? // Fecha límite fija (null = sin límite)
  dueDays        Int? // Plazo en días relativo a cada empleado (null = no aplica)
  estimatedHours Float? // Duración estimada
  passingScore   Int            @default(70) // % mínimo para aprobar
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  modules      Module[]
  assignments  CourseAssignment[]
  certificates Certificate[]
  grupos       Grupo[]            @relation("CourseGrupos")
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int // Orden dentro del curso
  createdAt   DateTime @default(now())

  lessons Lesson[]
  exams   Exam[]
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  type        LessonType
  content     Json // Estructura flexible según tipo (ver spec sección 6)
  order       Int
  durationMin Int? // Duración estimada en minutos
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  progress UserProgress[]
  comments LessonComment[]
}

model Exam {
  id               String   @id @default(cuid())
  moduleId         String?
  module           Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  passingScore     Int      @default(70) // % mínimo
  maxAttempts      Int      @default(3) // Intentos permitidos
  timeLimitMin     Int? // Tiempo límite en minutos (null = sin límite)
  shuffleQuestions Boolean  @default(true)
  order            Int      @default(0) // Posición en la secuencia del módulo (comparte orden con lecciones)
  createdAt        DateTime @default(now())

  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id            String       @id @default(cuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  question      String
  type          QuestionType
  options       Json // ["opcion1", "opcion2", ...] o null para FILL_BLANK
  correctAnswer Json // índice(s) correctos o texto esperado
  points        Int          @default(1)
  explanation   String? // Explicación mostrada al revisar
  order         Int
}

model CourseAssignment {
  id         String    @id @default(cuid())
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy String
  assignedAt DateTime  @default(now())
  dueDate    DateTime?

  @@unique([courseId, userId])
}

model UserProgress {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       ProgressStatus @default(NOT_STARTED)
  timeSpentSec Int            @default(0) // Tiempo real en la lección
  startedAt    DateTime?
  completedAt  DateTime?

  @@unique([userId, lessonId])
}

model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(COMPLETED)
  score       Float         @default(0) // Porcentaje obtenido (0 mientras está en curso)
  answers     Json // {questionId: respuesta_dada, ...}
  passed      Boolean       @default(false)
  tabSwitches Int           @default(0) // veces que salió de la pestaña (integridad)
  awaySeconds Int           @default(0) // segundos totales fuera de la pestaña
  startedAt   DateTime
  completedAt DateTime? // null mientras el examen está en curso

  @@index([userId, examId])
}

// Imágenes subidas por el admin para lecciones/cursos (se sirven en /api/imagenes/[id]).
// Pequeñas y comprimidas (≤1 MB): viven en la base para sobrevivir los deploys de Heroku.
model ImageAsset {
  id        String   @id @default(cuid())
  name      String
  mime      String
  size      Int // bytes
  data      Bytes
  createdAt DateTime @default(now())
}

// Foro por lección: preguntas y comentarios. Un comentario raíz (parentId null)
// es una pregunta; los que tienen parentId son respuestas (un solo nivel).
model LessonComment {
  id        String          @id @default(cuid())
  lessonId  String
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String? // null = pregunta; con valor = respuesta
  parent    LessonComment?  @relation("ComentarioRespuestas", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LessonComment[] @relation("ComentarioRespuestas")
  body      String
  createdAt DateTime        @default(now())

  @@index([lessonId])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt DateTime @default(now())
  code     String   @unique // Código verificable (ej: CERT-2026-XXXXX)

  @@unique([userId, courseId])
}
