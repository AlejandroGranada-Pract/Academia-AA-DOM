# Plantilla de variables de entorno. Copia este archivo a .env y completa los valores.
# (.env NO se versiona; este .env.example sí, como documentación.)

# Base de datos PostgreSQL
# Local:    postgresql://postgres:TU_PASSWORD@localhost:5432/academia_adom?schema=public
# Heroku:   se inyecta automáticamente como DATABASE_URL en producción
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/academia_adom?schema=public"

# NextAuth v5 — genera el secret con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Anthropic (asistente IA, Fase 2) — modelo Claude Sonnet
ANTHROPIC_API_KEY=""

# Correo / notificaciones (SMTP de Google Workspace). Si faltan, no se envían
# correos (no rompe nada). SMTP_PASS es una App Password de Google.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="notificaciones@ambienteazul.com.co"
SMTP_PASS=""
MAIL_FROM="Academia AA | DOM <notificaciones@ambienteazul.com.co>"

# Recordatorios de vencimiento: token secreto que protege /api/cron/recordatorios
# (lo llama el Heroku Scheduler). Genera uno con el mismo comando del NEXTAUTH_SECRET.
CRON_SECRET=""
